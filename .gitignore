# ---- Node / SvelteKit ----
node_modules
.svelte-kit
build
dist
.DS_Store
.env
.env.*
!.env.example
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- TypeScript ----
*.tsbuildinfo

# ---- Rust / Tauri ----
src-tauri/target/
# NOTE: Cargo.lock IS committed on purpose — DozeForge is an application
# (binary), so a pinned lockfile gives reproducible builds. Do not ignore it.
src-tauri/WixTools/
src-tauri/gen/
**/*.rs.bk

# ---- Bundled scrcpy binaries (~40 MB, fetched by scripts/setup-scrcpy.mjs) ----
src-tauri/scrcpy/*
!src-tauri/scrcpy/README.md

# ---- IDE ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.template
.idea/
*.swp
*.swo

# ---- OS ----
Thumbs.db
desktop.ini

# ---- DozeForge runtime ----
snapshots/
exports/
logs/
manifests/local-overrides.json

# ---- Local device diagnostic dumps (never commit) ----
# adb/dumpsys captures generated while debugging on real devices.
/batterystats.txt
/*-diag.txt
/diag-*.txt
/*.dump.txt
